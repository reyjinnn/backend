# Database Configuration (MySQL 8.0)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=""

# Redis Configuration
# Format: redis://HOST:PORT
REDIS_URL="redis://localhost:6379"

# Security
# Secret key used for signing JWT tokens
JWT_SECRET="replace_with_strong_secret_key_in_production"

# Logging
# Supported levels: fatal, error, warn, info, debug, trace
LOG_LEVEL="info"

# CORS Security
# Comma-separated list of allowed origins
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# Service Ports
PORT_API_GATEWAY=3000
PORT_IDENTITY_SERVICE=3001
PORT_CATALOG_SERVICE=3002
PORT_ORDER_SERVICE=3003
PORT_POINT_SERVICE=3004
PORT_TLATER_SERVICE=3005

# Internal Service Networking (For API Gateway Proxy)
IDENTITY_SERVICE_URL="http://localhost:3001"
CATALOG_SERVICE_URL="http://localhost:3002"
ORDER_SERVICE_URL="http://localhost:3003"
POINT_SERVICE_URL="http://localhost:3004"
TLATER_SERVICE_URL="http://localhost:3005"
