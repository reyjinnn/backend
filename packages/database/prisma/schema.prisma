generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// 1. IDENTITAS & KYC
// ----------------------------------------------------------------------------
model User {
  id             BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  name           String        @db.VarChar(150)
  email          String        @unique @db.VarChar(150)
  phone          String        @unique @db.VarChar(25)
  password_hash  String        @db.VarChar(255)
  role           Role          @default(customer)
  status         UserStatus    @default(active)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at")
  
  profile        UserProfile?
  pointWallet    PointWallet?
  pointLedgers   PointLedger[]
  tlaterAccount  TlaterAccount?
  orders         Order[]

  addresses      UserAddress[]
  wishlists      Wishlist[]
  reviews        ProductReview[]
  promoUsages    UserPromoUsage[]
  tickets        SupportTicket[]
  notifications  Notification[]

  @@map("users")
}

enum Role {
  customer
  admin
  superadmin
}

enum UserStatus {
  active
  suspended
  banned
}

model UserProfile {
  userId           BigInt       @id @db.UnsignedBigInt @map("user_id")
  nik              String?      @unique @db.VarChar(16)
  dateOfBirth      DateTime?    @map("date_of_birth") @db.Date
  address          String?      @db.Text
  ktpImageUr       String?      @map("ktp_image_url") @db.VarChar(255)
  selfieImageUr    String?      @map("selfie_image_url") @db.VarChar(255)
  kycStatus        KycStatus    @default(unverified) @map("kyc_status")
  kycVerifiedAt    DateTime?    @map("kyc_verified_at")
  rejectionReason  String?      @map("rejection_reason") @db.VarChar(255)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at")

  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

enum KycStatus {
  unverified
  pending
  verified
  rejected
}

// ----------------------------------------------------------------------------
// 2. KATALOG & INVENTORI (DENGAN ISOLASI STOK)
// ----------------------------------------------------------------------------
model Category {
  id          Int        @id @default(autoincrement()) @db.UnsignedInt
  name        String     @db.VarChar(100)
  slug        String     @unique @db.VarChar(120)
  description String?    @db.Text
  parentId    Int?       @map("parent_id") @db.UnsignedInt
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at")

  parent      Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryToCategory")
  products    Product[]

  @@map("categories")
}

model Product {
  id           BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  categoryId   Int           @map("category_id") @db.UnsignedInt
  sku          String        @unique @db.VarChar(64)
  name         String        @db.VarChar(255)
  slug         String        @unique @db.VarChar(255)
  description  String?       @db.LongText
  price        Decimal       @db.Decimal(14, 2)
  originalPrice Decimal?     @map("original_price") @db.Decimal(14, 2)
  weightGrams  Int           @default(1000) @map("weight_grams") @db.UnsignedInt
  status       ProductStatus @default(draft)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at")

  category     Category      @relation(fields: [categoryId], references: [id])
  stock        ProductStock?
  images       ProductImage[]
  orderItems   OrderItem[]
  wishlists    Wishlist[]
  reviews      ProductReview[]

  @@map("products")
}

enum ProductStatus {
  draft
  active
  archived
}

model ProductStock {
  productId     BigInt   @id @map("product_id") @db.UnsignedBigInt
  stock         Int      @default(0) @db.UnsignedInt
  reservedStock Int      @default(0) @map("reserved_stock") @db.UnsignedInt
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_stocks")
}

model ProductImage {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  productId  BigInt   @map("product_id") @db.UnsignedBigInt
  imageUrl   String   @map("image_url") @db.VarChar(255)
  isPrimary  Boolean  @default(false) @map("is_primary")
  sortOrder  Int      @default(0) @map("sort_order") @db.SmallInt
  createdAt  DateTime @default(now()) @map("created_at")

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

// ----------------------------------------------------------------------------
// 3. ORDERS, ITEMS, & SPLIT PAYMENT
// ----------------------------------------------------------------------------
model Order {
  id               BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  orderNumber      String      @unique @map("order_number") @db.VarChar(50)
  userId           BigInt      @map("user_id") @db.UnsignedBigInt
  totalItemAmount  Decimal     @map("total_item_amount") @db.Decimal(14, 2)
  shippingFee      Decimal     @default(0.00) @map("shipping_fee") @db.Decimal(14, 2)
  insuranceFee     Decimal     @default(0.00) @map("insurance_fee") @db.Decimal(14, 2)
  discountAmount   Decimal     @default(0.00) @map("discount_amount") @db.Decimal(14, 2)
  grandTotal       Decimal     @map("grand_total") @db.Decimal(14, 2)
  status           OrderStatus @default(pending)
  shippingAddress  String      @map("shipping_address") @db.Text
  courierName      String?     @map("courier_name") @db.VarChar(100)
  courierService   String?     @map("courier_service") @db.VarChar(50)
  trackingNumber   String?     @map("tracking_number") @db.VarChar(100)
  notes            String?     @db.Text
  paidAt           DateTime?   @map("paid_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @default(now()) @updatedAt @map("updated_at")

  user             User            @relation(fields: [userId], references: [id])
  items            OrderItem[]
  payments         OrderPayment[]
  tlaterLoan       TlaterLoan?
  shipment         OrderShipment?

  @@map("orders")
}

enum OrderStatus {
  pending
  paid
  processing
  shipped
  completed
  cancelled
  refunded
}

model OrderItem {
  id                  BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  orderId             BigInt   @map("order_id") @db.UnsignedBigInt
  productId           BigInt   @map("product_id") @db.UnsignedBigInt
  productNameSnapshot String   @map("product_name_snapshot") @db.VarChar(255)
  priceSnapshot       Decimal  @map("price_snapshot") @db.Decimal(14, 2)
  quantity            Int      @db.UnsignedInt
  subtotal            Decimal  @db.Decimal(14, 2)
  createdAt           DateTime @default(now()) @map("created_at")

  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product  @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model OrderPayment {
  id             BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  orderId        BigInt        @map("order_id") @db.UnsignedBigInt
  paymentMethod  PaymentMethod @map("payment_method")
  amount         Decimal       @db.Decimal(14, 2)
  status         PaymentStatus @default(pending)
  referenceId    String?       @map("reference_id") @db.VarChar(100)
  settledAt      DateTime?     @map("settled_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_payments")
}

enum PaymentMethod {
  gateway_cash
  point
  tlater
}

enum PaymentStatus {
  pending
  settled
  failed
  refunded
}

// ----------------------------------------------------------------------------
// 4. DOMPET & BUKU KAS POIN LOYALITAS
// ----------------------------------------------------------------------------
model PointWallet {
  userId         BigInt   @id @map("user_id") @db.UnsignedBigInt
  balance        BigInt   @default(0) @db.UnsignedBigInt
  lockedBalance  BigInt   @default(0) @map("locked_balance") @db.UnsignedBigInt
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("point_wallets")
}

model PointLedger {
  id             BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  userId         BigInt            @map("user_id") @db.UnsignedBigInt
  idempotencyKey String            @unique @map("idempotency_key") @db.VarChar(100)
  type           LedgerType
  amount         BigInt            @db.UnsignedBigInt
  balanceAfter   BigInt            @map("balance_after") @db.UnsignedBigInt
  referenceType  LedgerReferenceType @map("reference_type")
  referenceId    String?           @map("reference_id") @db.VarChar(100)
  description    String            @db.VarChar(255)
  expiresAt      DateTime?         @map("expires_at")
  status         LedgerStatus      @default(completed)
  createdAt      DateTime          @default(now()) @map("created_at")

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("point_ledgers")
}

enum LedgerType {
  credit
  debit
}

enum LedgerReferenceType {
  order_reward
  order_redemption
  manual_adjustment
  expired
  refund
}

enum LedgerStatus {
  pending
  completed
  cancelled
}

// ----------------------------------------------------------------------------
// 5. ENGINE TLATER (PAYLATER, LOANS, INSTALLMENTS)
// ----------------------------------------------------------------------------
model TlaterAccount {
  id                  BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  userId              BigInt        @unique @map("user_id") @db.UnsignedBigInt
  creditLimit         Decimal       @default(0.00) @map("credit_limit") @db.Decimal(14, 2)
  availableLimit      Decimal       @default(0.00) @map("available_limit") @db.Decimal(14, 2)
  interestRateMonthly Decimal       @default(2.50) @map("interest_rate_monthly") @db.Decimal(5, 2)
  lateFeeDaily        Decimal       @default(0.10) @map("late_fee_daily") @db.Decimal(5, 2)
  status              TlaterStatus  @default(pending_kyc)
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @default(now()) @updatedAt @map("updated_at")

  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  loans               TlaterLoan[]

  @@map("tlater_accounts")
}

enum TlaterStatus {
  pending_kyc
  active
  suspended
  blocked
}

model TlaterLoan {
  id               BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  accountId        BigInt         @map("account_id") @db.UnsignedBigInt
  orderId          BigInt         @unique @map("order_id") @db.UnsignedBigInt
  loanCode         String         @unique @map("loan_code") @db.VarChar(50)
  principalAmount  Decimal        @map("principal_amount") @db.Decimal(14, 2)
  adminFee         Decimal        @default(0.00) @map("admin_fee") @db.Decimal(14, 2)
  interestRate     Decimal        @map("interest_rate") @db.Decimal(5, 2)
  totalInterest    Decimal        @map("total_interest") @db.Decimal(14, 2)
  totalLoanAmount  Decimal        @map("total_loan_amount") @db.Decimal(14, 2)
  tenorMonths      Int            @default(1) @map("tenor_months") @db.UnsignedTinyInt
  status           LoanStatus     @default(active)
  disbursedAt      DateTime       @default(now()) @map("disbursed_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at")

  account          TlaterAccount  @relation(fields: [accountId], references: [id])
  order            Order          @relation(fields: [orderId], references: [id])
  installments     TlaterInstallment[]

  @@map("tlater_loans")
}

enum LoanStatus {
  active
  fully_paid
  defaulted
}

model TlaterInstallment {
  id               BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  loanId           BigInt             @map("loan_id") @db.UnsignedBigInt
  installmentNumber Int               @map("installment_number") @db.UnsignedTinyInt
  principalDue     Decimal            @map("principal_due") @db.Decimal(14, 2)
  interestDue      Decimal            @map("interest_due") @db.Decimal(14, 2)
  lateFee          Decimal            @default(0.00) @map("late_fee") @db.Decimal(14, 2)
  totalDue         Decimal            @map("total_due") @db.Decimal(14, 2)
  totalPaid        Decimal            @default(0.00) @map("total_paid") @db.Decimal(14, 2)
  dueDate          DateTime           @map("due_date") @db.Date
  status           InstallmentStatus  @default(unpaid)
  paidAt           DateTime?          @map("paid_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at")

  loan             TlaterLoan         @relation(fields: [loanId], references: [id], onDelete: Cascade)
  repayments       TlaterRepayment[]

  @@index([dueDate, status])
  @@map("tlater_installments")
}

enum InstallmentStatus {
  unpaid
  partially_paid
  paid
  overdue
}

model TlaterRepayment {
  id               BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  installmentId    BigInt             @map("installment_id") @db.UnsignedBigInt
  paymentReference String             @unique @map("payment_reference") @db.VarChar(100)
  amount           Decimal            @db.Decimal(14, 2)
  paidAt           DateTime           @default(now()) @map("paid_at")

  installment      TlaterInstallment  @relation(fields: [installmentId], references: [id])

  @@map("tlater_repayments")
}

// ----------------------------------------------------------------------------
// 6. MULTI-ADDRESS, WISHLIST, REVIEWS
// ----------------------------------------------------------------------------
model UserAddress {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId         BigInt   @map("user_id") @db.UnsignedBigInt
  label          String   @default("Rumah") @db.VarChar(50)
  recipientName  String   @map("recipient_name") @db.VarChar(100)
  phone          String   @db.VarChar(25)
  addressLine    String   @map("address_line") @db.Text
  city           String   @db.VarChar(100)
  postalCode     String   @map("postal_code") @db.VarChar(10)
  isPrimary      Boolean  @default(false) @map("is_primary")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_addresses")
}

model Wishlist {
  userId         BigInt   @map("user_id") @db.UnsignedBigInt
  productId      BigInt   @map("product_id") @db.UnsignedBigInt
  createdAt      DateTime @default(now()) @map("created_at")

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@map("wishlists")
}

model ProductReview {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  productId      BigInt   @map("product_id") @db.UnsignedBigInt
  userId         BigInt   @map("user_id") @db.UnsignedBigInt
  orderId        BigInt   @map("order_id") @db.UnsignedBigInt
  rating         Int      @default(5) @db.UnsignedTinyInt
  reviewText     String?  @map("review_text") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_reviews")
}

// ----------------------------------------------------------------------------
// 7. PROMO ENGINE & USAGE
// ----------------------------------------------------------------------------
model Promo {
  id             BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  name           String      @db.VarChar(150)
  description    String?     @db.Text
  code           String?     @unique @db.VarChar(50)
  type           PromoType   @default(voucher)
  valueType      ValueType   @default(persen) @map("value_type")
  value          Decimal     @db.Decimal(14, 2)
  maxDiscount    Decimal?    @map("max_discount") @db.Decimal(14, 2)
  startDate      DateTime    @map("start_date") @db.Date
  endDate        DateTime    @map("end_date") @db.Date
  minPurchase    Decimal     @default(0.00) @map("min_purchase") @db.Decimal(14, 2)
  quota          Int?        @db.UnsignedInt
  usedCount      Int         @default(0) @map("used_count") @db.UnsignedInt
  maxPerUser     Int         @default(1) @map("max_per_user") @db.UnsignedInt
  targetType     TargetType  @default(semua) @map("target_type")
  audienceType   AudienceType @default(semua) @map("audience_type")
  status         PromoStatus @default(active)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at")

  usages         UserPromoUsage[]

  @@index([status, code])
  @@map("promos")
}

enum PromoType {
  flash_sale
  voucher
  diskon_otomatis
}

enum ValueType {
  persen
  nominal
  poin
}

enum TargetType {
  semua
  kategori
  produk
}

enum AudienceType {
  semua
  baru
  member
  tlater
}

enum PromoStatus {
  draft
  active
  ended
  disabled
}

model UserPromoUsage {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId         BigInt   @map("user_id") @db.UnsignedBigInt
  promoId        BigInt   @map("promo_id") @db.UnsignedBigInt
  orderId        BigInt   @map("order_id") @db.UnsignedBigInt
  discountAmount Decimal  @map("discount_amount") @db.Decimal(14, 2)
  usedAt         DateTime @default(now()) @map("used_at")

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  promo          Promo    @relation(fields: [promoId], references: [id], onDelete: Cascade)

  @@index([userId, promoId])
  @@map("user_promo_usages")
}

// ----------------------------------------------------------------------------
// 8. SHIPMENTS, TICKETS & NOTIFICATIONS
// ----------------------------------------------------------------------------
model OrderShipment {
  id             BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  orderId        BigInt          @unique @map("order_id") @db.UnsignedBigInt
  courierName    String          @map("courier_name") @db.VarChar(100)
  trackingNumber String?         @map("tracking_number") @db.VarChar(100)
  shippingStatus ShippingStatus  @default(packing) @map("shipping_status")
  timelineJson   Json?           @map("timeline_json")
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at")

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_shipments")
}

enum ShippingStatus {
  packing
  picked_up
  in_transit
  delivered
  returned
}

model SupportTicket {
  id             String          @id @db.VarChar(50)
  userId         BigInt          @map("user_id") @db.UnsignedBigInt
  subject        String          @db.VarChar(255)
  category       TicketCategory
  status         TicketStatus    @default(open)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       TicketMessage[]

  @@index([userId, status])
  @@map("support_tickets")
}

enum TicketCategory {
  Pesanan
  Pembayaran
  Pengiriman
  Garansi
  TLater
  Vibe_Points     @map("Vibe Points")
  Lainnya
}

enum TicketStatus {
  open
  in_progress
  completed
}

model TicketMessage {
  id             BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  ticketId       String      @map("ticket_id") @db.VarChar(50)
  senderType     SenderType  @map("sender_type")
  senderId       BigInt      @map("sender_id") @db.UnsignedBigInt
  message        String      @db.Text
  createdAt      DateTime    @default(now()) @map("created_at")

  ticket         SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_messages")
}

enum SenderType {
  user
  admin
}

model Notification {
  id             BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  userId         BigInt           @map("user_id") @db.UnsignedBigInt
  title          String           @db.VarChar(150)
  body           String           @db.Text
  type           NotificationType @default(general)
  isRead         Boolean          @default(false) @map("is_read")
  referenceId    String?          @map("reference_id") @db.VarChar(100)
  createdAt      DateTime         @default(now()) @map("created_at")

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

enum NotificationType {
  shipping
  promo
  ticket
  points
  general
}
