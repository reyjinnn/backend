{
  "name": "tech-vibe-core",
  "version": "1.0.0",
  "private": true,
  "description": "Tech Vibe Core Engine",
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "npx turbo@2.10.12 run dev",
    "lint": "turbo run lint",
    "start": "docker compose -f docker/docker-compose.yml up -d",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@fastify/swagger": "^9.9.0",
    "@types/node": "^22.0.0",
    "ts-morph": "^28.0.0",
    "turbo": "2.10.12",
    "typescript": "^5.5.0"
  }
}
